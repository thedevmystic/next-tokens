{
  "name": "next-tokens-monorepo",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo build",
    "build:package": "turbo build:package",
    "dev": "turbo dev",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e",
    "test": "turbo test:unit && turbo test:e2e",
    "type-check": "turbo type-check",
